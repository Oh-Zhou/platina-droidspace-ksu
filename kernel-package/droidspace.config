# Droidspace (Droidspaces-OSS) 内核配置片段 — 适配 Linux 4.19.325 (sdm660/platina)
# 来源: ravindu644/Droidspaces-OSS Documentation/zh-CN/Kernel-Configuration.md (非GKI步骤1+步骤2)
# 依据本树 Kconfig 逐条核实后的 4.19 版本(符号名/依赖已对照修改), 见各行注释。
#
# 用法(作为最后一个片段合并; 基座必须用设备 SoC defconfig, 见 README §2D):
#   scripts/kconfig/merge_config.sh -m -O out \
#     arch/arm64/configs/vendor/sdm660_defconfig \
#     arch/arm64/configs/vendor/xiaomi/sdm660-common.config \
#     arch/arm64/configs/vendor/xiaomi/platina.config \
#     <本文件>

# ==================== 步骤 1: Droidspaces 必要配置 ====================

# IPC 机制
CONFIG_SYSCTL=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y

# 核心命名空间支持
CONFIG_NAMESPACES=y
CONFIG_PID_NS=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y

# Seccomp 支持
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# 控制组支持
CONFIG_CGROUPS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_PIDS=y
CONFIG_MEMCG=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_NET_PRIO=y

# 设备文件系统支持
CONFIG_DEVTMPFS=y

# Overlay 文件系统支持(易失模式必需; 覆盖 defconfig 的 =m)
CONFIG_OVERLAY_FS=y

# tmpfs xattr/posix acl(用于 NixOS 支持)
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y

# 固件加载(本树无 FW_LOADER_COMPRESS 符号, 已省略)
CONFIG_FW_LOADER=y
CONFIG_FW_LOADER_USER_HELPER=y

# ---- Droidspaces 网络隔离(NAT 模式 / 无网络模式) ----
CONFIG_NET_NS=y
CONFIG_VETH=y            # 覆盖 defconfig 的 =m
# IPv6 内置: 4.19 中 BRIDGE/TCPMSS/hashlimit 等依赖 "IPV6 || IPV6=n",
# defconfig 为 IPV6=m 会把它们钳在 =m, 故置 y
CONFIG_IPV6=y
CONFIG_BRIDGE=y          # 覆盖 defconfig 的 =m (依赖 IPV6=y)
CONFIG_NETFILTER=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_NF_NAT=y
CONFIG_NF_TABLES=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
# 注: 4.19 无 NETFILTER_XT_TARGET_MASQUERADE 符号, 已由 IP_NF_TARGET_MASQUERADE 承担
CONFIG_NETFILTER_XT_TARGET_TCPMSS=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
# 4.19 的 conntrack netlink 符号名是 NF_CT_NETLINK(替代文档的 NF_CONNTRACK_NETLINK)
CONFIG_NF_CT_NETLINK=y
# NF_NAT_REDIRECT 为无提示 bool, 由 REDIRECT 目标 select 置位
CONFIG_NETFILTER_XT_TARGET_REDIRECT=y
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
# 注: 4.19 无 NF_CONNTRACK_IPV4 符号(conntrack 已并入 NF_CONNTRACK)
CONFIG_NF_NAT_IPV4=y
CONFIG_IP_NF_NAT=y
# 让 IP6 侧 iptables 内置, 解锁 hashlimit 等上限 (IPV6=y 时 IP6_NF_IPTABLES 默认 m)
CONFIG_IP6_NF_IPTABLES=y

# 旧内核: 禁用此选项使容器内互联网正常(本树无 xt_qtaguid)
CONFIG_ANDROID_PARANOID_NETWORK=n

# 修复 Docker unsafe procfs 错误
CONFIG_USER_NS=y

# ==================== 步骤 2: 防火墙支持 (UFW / Fail2ban) ====================
# 容器内运行 UFW/Fail2ban 需要; 运行时请用 NAT 模式

CONFIG_NETFILTER_XT_MATCH_COMMENT=y
CONFIG_NETFILTER_XT_MATCH_STATE=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=y
CONFIG_NETFILTER_XT_MATCH_HL=y
# 注: 4.19 无 NETFILTER_XT_TARGET_REJECT 符号, 由 IP_NF_TARGET_REJECT(y)承担
CONFIG_IP_NF_TARGET_REJECT=y
CONFIG_NETFILTER_XT_TARGET_LOG=y
# 注: IP_NF_TARGET_ULOG 在 4.19 已移除, 符号不存在会被丢弃(不影响 UFW, 其用 NFLOG)
CONFIG_NETFILTER_XT_MATCH_RECENT=y
CONFIG_NETFILTER_XT_MATCH_LIMIT=y
CONFIG_NETFILTER_XT_MATCH_HASHLIMIT=y
CONFIG_NETFILTER_XT_MATCH_OWNER=y
CONFIG_NETFILTER_XT_MATCH_PKTTYPE=y
CONFIG_NETFILTER_XT_MATCH_MARK=y
CONFIG_NETFILTER_XT_TARGET_MARK=y
CONFIG_IP_SET=y
CONFIG_IP_SET_HASH_IP=y
CONFIG_IP_SET_HASH_NET=y
CONFIG_NETFILTER_XT_SET=y
CONFIG_NETFILTER_NETLINK_QUEUE=y
CONFIG_NETFILTER_NETLINK_LOG=y
CONFIG_NETFILTER_XT_TARGET_NFLOG=y
