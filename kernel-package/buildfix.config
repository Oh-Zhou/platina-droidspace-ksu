# ============================================================
# buildfix.config — 本树编译/启动必需修正(与 Droidspace 功能无关)
# 说明见 HANDOFF-交接文档 §7「新会话实测修正」/ README §2E
#
# 1) CONFIG_ANDROID_VENDOR_HOOKS=y
#    fs/open.c 无条件调用 trace_android_vh_check_file_open(), 而该
#    tracepoint 的定义位于 drivers/android/vendor_hooks.o, 由本符号 gating
#    (depends on TRACEPOINTS)。vendor/sdm660_defconfig 未开启时,
#    vmlinux 链接阶段报:
#      undefined reference to `__tracepoint_android_vh_check_file_open'
#
# 2) CONFIG_RD_LZ4=y
#    实机 ROM (Project Infinity X, Android 16) 的 boot.img ramdisk 为 LZ4
#    压缩; 本树 vendor/sdm660_defconfig 显式 `# CONFIG_RD_LZ4 is not set`,
#    不开则内核解不开 initramfs, 卡在开机 logo(实测 2026-09-03)。
#
# 3) CONFIG_KSU=y / CONFIG_KSU_MANUAL_HOOK=y
#    保留 KernelSU(分支 lineage-23.2-ksu 的核心价值; ROM stock config 无 KSU,
#    但用户日常用的 ksu 内核带 root)。KSU 源码在本树 kernel/ksu 与
#    drivers/kernelsu。
#
# 4) CONFIG_MODULES=y
#    本树 net/Kconfig 的 CONFIG_BPF_JIT 依赖 MODULES(rom.config 为单体内核
#    MODULES=n, 但其 BPF_JIT=y/ALWAYS_ON=y 说明 ROM 用的内核树无此依赖)。
#    不开 MODULES 则 BPF_JIT 被 conf 静默丢弃, 而 kernel/bpf/verifier.c 无条件
#    调用 bpf_jit_blinding_enabled()(声明仅在 BPF_JIT=y 可见) -> 编译报
#    implicit declaration。开 MODULES=y 仅增加模块支持框架, 不影响内置驱动;
#    设备上无 .ko 需要加载, 行为与 ROM 单体一致(实测 2026-09-03)。
#
# 5) CONFIG_BUG=y
#    rom.config 为 `# CONFIG_BUG is not set`(单体精简), 但本树
#    kernel/sched/walt.c、drivers/mmc/host/sdhci-msm.c 等无条件调用
#    __WARN_printf(), 其声明仅在 CONFIG_BUG=y 时存在(include/asm-generic/bug.h)
#    -> 编译报 implicit declaration of '__WARN_printf'。开 CONFIG_BUG=y 为
#    标准行为(BUG/WARN 生效), 便于排错(实测 2026-09-03)。
#
# 6) CONFIG_PSI=y
#    ROM(Project Infinity X)的 lmkd 在无 PSI 时回退到 cgroup v1 vmpressure
#    全局监控; 而我们按 Droidspace 官方要求开了 CONFIG_MEMCG=y(memory 仅以
#    v2 形态存在), v1 路径失败 -> lmkd 打印 "global monitoring is only
#    available for the v1 cgroup hierarchy" 后退场 -> system_server AMS
#    "Failed to connect to lowmemorykiller" 刷屏 -> 开机慢/系统无响应
#    (实测 2026-09-03)。开 CONFIG_PSI=y 让 lmkd 走 v2 PSI 监控路径。
# ============================================================
CONFIG_ANDROID_VENDOR_HOOKS=y
CONFIG_RD_LZ4=y
CONFIG_KSU=y
CONFIG_KSU_MANUAL_HOOK=y
CONFIG_MODULES=y
CONFIG_BUG=y
CONFIG_PSI=y
