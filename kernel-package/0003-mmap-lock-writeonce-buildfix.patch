diff --git a/include/linux/compiler.h b/include/linux/compiler.h
index 41e9b74ef..09abf0cd2 100644
--- a/include/linux/compiler.h
+++ b/include/linux/compiler.h
@@ -275,10 +275,17 @@ void ftrace_likely_update(struct ftrace_likely_data *f, int val,
 	__x;								\
 })
 
+/*
+ * 本树原始 WRITE_ONCE 为 do-while 语句版(CAF 变更), 但 lib/fault-inject.c
+ * 等按上游 4.19 把它当表达式用 (if (!WRITE_ONCE(...))) -> 恢复为上游 v4.19
+ * 语义的语句表达式版(返回写入值, 单次求值 val), 见 HANDOFF 交接记录。
+ */
 #define WRITE_ONCE(x, val)				\
-do {							\
-	*(volatile typeof(x) *)&(x) = (val);		\
-} while (0)
+({							\
+	typeof(x) __val = (val);			\
+	*(volatile typeof(x) *)&(x) = __val;		\
+	__val;						\
+})
 
