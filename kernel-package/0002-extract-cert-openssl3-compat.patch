+/*
+ * OpenSSL >= 3.0 removed the legacy ENGINE API, and <openssl/engine.h>
+ * no longer exists since OpenSSL 3.5 (e.g. Fedora 44).  Kernel builds
+ * never pass a "pkcs11:" source (CONFIG_SYSTEM_TRUSTED_KEYS is a PEM
+ * path or empty), so on OpenSSL 3.x compile the ENGINE path out by
+ * reusing the existing BoringSSL fallback in main() below.
+ */
+#if OPENSSL_VERSION_NUMBER >= 0x30000000L
+#define OPENSSL_IS_BORINGSSL
+#else
 #include <openssl/engine.h>
 
 /*
@@ -29,6 +41,7 @@
